# Copy to .env before using Docker Compose or the API/migration commands.
# These values are for local development only; never reuse them in production.
RIFF_POSTGRES_DB=riff
RIFF_POSTGRES_USER=riff
RIFF_POSTGRES_PASSWORD=riff-local-only
RIFF_DATABASE_URL=postgresql://riff:riff-local-only@localhost:5432/riff
RIFF_ENV=development
RIFF_LOG_LEVEL=INFO
# Optional for non-loopback connector deployments; never commit a real token.
RIFF_ADAPTER_TOKEN=
# Comma-separated MCP Host/origin allowlists for a deployed HTTPS endpoint.
# Leave empty for loopback-only development defaults.
# Live reasoning is provider-neutral; deterministic is the safe local default.
RIFF_REASONING_PROVIDER=deterministic
RIFF_REASONING_MODEL=auto
RIFF_REASONING_API_KEY=
RIFF_REASONING_BASE_URL=https://api.openai.com/v1
RIFF_REASONING_CONTEXT_POLICY=riff-context-v1
# Set provider=recorded and point this at a reviewed response fixture for offline replay.
RIFF_REASONING_FIXTURE=
RIFF_REASONING_MAX_CALLS=5
RIFF_REASONING_MAX_INPUT_TOKENS=12000
RIFF_REASONING_MAX_OUTPUT_TOKENS=6000
RIFF_REASONING_MAX_COST_USD=1.0
RIFF_REASONING_TIMEOUT_SECONDS=60
RIFF_REASONING_INPUT_COST_PER_1K=0
RIFF_REASONING_OUTPUT_COST_PER_1K=0
RIFF_MCP_ALLOWED_HOSTS=
RIFF_MCP_ALLOWED_ORIGINS=
